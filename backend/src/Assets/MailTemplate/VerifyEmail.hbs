<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Flazly Account</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;">
  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; padding: 40px 20px;">
    <tr>
      <td align="center">
        <!-- Main Card Container -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 580px; background-color: #ffffff; border-radius: 24px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);">
          
          <!-- Logo Header -->
          <tr>
            <td align="center" style="padding: 40px 40px 20px 40px;">
              <img src="{{logo}}" alt="Flazly Logo" style="height: 48px; width: auto;" />
            </td>
          </tr>

          <!-- Content Body -->
          <tr>
            <td style="padding: 20px 40px 40px 40px; text-align: center;">
              
              <!-- Checkmark Icon Area -->
              <table border="0" cellpadding="0" cellspacing="0" align="center" style="margin-bottom: 24px;">
                <tr>
                  <td align="center" style="background-color: #f3e8ff; border-radius: 50%; width: 64px; height: 64px;">
                    <span style="font-size: 32px; color: #7c3aed; line-height: 64px;">✓</span>
                  </td>
                </tr>
              </table>

              <!-- Heading -->
              <h1 style="font-size: 28px; font-weight: 800; color: #1e1b4b; margin: 0 0 16px 0; letter-spacing: -0.5px;">
                Activate Your Account
              </h1>

              <!-- Paragraph Description -->
              <p style="font-size: 15px; line-height: 24px; color: #475569; margin: 0 0 28px 0; font-weight: 500;">
                Hi <strong>{{first_name}}</strong>, welcome to Flazly! We're excited to help you automate and grow your Instagram engagement. To get started, please verify your email address by clicking the button below.
              </p>

              <!-- Call to Action Button -->
              <table border="0" cellpadding="0" cellspacing="0" align="center" style="margin-bottom: 32px;">
                <tr>
                  <td align="center" style="background-color: #7c3aed; border-radius: 14px;">
                    <a href="{{verify_url}}" target="_blank" style="display: inline-block; padding: 14px 32px; font-size: 15px; font-weight: 700; color: #ffffff; text-decoration: none; border-radius: 14px; letter-spacing: 0.2px;">
                      Verify My Email Address
                    </a>
                  </td>
                </tr>
              </table>

              {{#if temp_password}}
              <!-- Credentials Block -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #faf5ff; border: 1px dashed #d8b4fe; border-radius: 16px; margin-bottom: 28px;">
                <tr>
                  <td style="padding: 24px; text-align: center;">
                    <span style="font-size: 13px; font-weight: 700; color: #6b21a8; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 8px;">
                      Your Temporary Login Credentials
                    </span>
                    <span style="font-size: 14px; color: #581c87; font-weight: 600; display: block; margin-bottom: 4px;">
                      Email: <span style="font-weight: 700;">{{email}}</span>
                    </span>
                    <span style="font-size: 18px; font-family: monospace; font-weight: 800; color: #7c3aed; display: block; letter-spacing: 1px; margin: 8px 0;">
                      {{temp_password}}
                    </span>
                    <span style="font-size: 11px; color: #701a75; font-weight: 500; display: block;">
                      Please change this password after your first login.
                    </span>
                  </td>
                </tr>
              </table>
              {{/if}}

              <!-- Info Warning Footer -->
              <p style="font-size: 13px; color: #94a3b8; margin: 0; font-weight: 500;">
                If you did not sign up for Flazly, you can safely ignore this email.
              </p>

            </td>
          </tr>

          <!-- Footer Area -->
          <tr>
            <td align="center" style="padding: 30px 40px; background-color: #f8fafc; border-top: 1px solid #e2e8f0; text-align: center;">
              <p style="font-size: 12px; color: #64748b; margin: 0 0 12px 0; font-weight: 600;">
                © 2026 Flazly Platforms Pvt Ltd.
              </p>
              <p style="font-size: 11px; color: #94a3b8; margin: 0 0 16px 0; font-weight: 500;">
                Coimbatore, Tamil Nadu, India
              </p>
              
              <!-- Social Links -->
              <table border="0" cellpadding="0" cellspacing="0" align="center">
                <tr>
                  <td>
                    <a href="#" style="font-size: 12px; color: #7c3aed; text-decoration: none; font-weight: 700; margin: 0 10px;">Twitter</a>
                  </td>
                  <td style="color: #cbd5e1;">•</td>
                  <td>
                    <a href="#" style="font-size: 12px; color: #7c3aed; text-decoration: none; font-weight: 700; margin: 0 10px;">LinkedIn</a>
                  </td>
                  <td style="color: #cbd5e1;">•</td>
                  <td>
                    <a href="#" style="font-size: 12px; color: #7c3aed; text-decoration: none; font-weight: 700; margin: 0 10px;">Instagram</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
