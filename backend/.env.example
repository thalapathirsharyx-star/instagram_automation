NODE_ENV=production
DOMAIN_NAME=https://flazly.in

# --- Database ---
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_USER=YOUR_DB_USER
DB_PASS=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME
DB_SEED=false
# Keep false in production. Schema changes must be applied as explicit migrations.
DB_SYNC=false
DB_LOG=false

PORT=8001

# --- Secrets ---
# SECERT_KEY also encrypts stored Meta access tokens at rest (SecretColumn.transformer.ts).
# Changing it makes every already-stored Instagram token undecryptable and every
# connected account must be reconnected. Generate with: openssl rand -hex 32
SECERT_KEY=GENERATE_A_UNIQUE_RANDOM_VALUE
TOKEN_SECRET=GENERATE_A_DIFFERENT_UNIQUE_RANDOM_VALUE
ExpiresIn=1d

# --- Audit log (optional) ---
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_DB=
AUDIT_LOG=false

# --- Redis (required: webhook de-duplication and usage alerts) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Meta / Instagram ---
FB_APP_ID=YOUR_FB_APP_ID
FB_APP_SECRET=YOUR_FB_APP_SECRET
# Must match the Verify Token configured in the Meta App Dashboard webhook settings.
IG_CRM_VERIFY_TOKEN=YOUR_SECURE_WEBHOOK_VERIFY_TOKEN
# Graph API version for every Meta call. Roll forward before the current version is
# deprecated (Meta retires a version roughly two years after release).
META_GRAPH_VERSION=v21.0
# Local debugging only — ignored when NODE_ENV=production.
BYPASS_SIGNATURE=false

# --- Payments ---
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# --- LLM providers ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY

# --- Google Sign-In ---
# Required: GoogleLogin verifies the token audience against this client id.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
