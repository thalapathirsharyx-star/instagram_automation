# The dev server runs over HTTPS (required by Facebook Login) and proxies these paths to
# the backend — see vite.config.ts. Keep them relative: an absolute http://localhost URL
# would be blocked by the browser as mixed content on an HTTPS page.
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/

# Where Vite proxies /api and /socket.io during development.
DEV_BACKEND_URL=http://localhost:8001

VITE_GOOGLE_CLIENT_ID=426061817600-gf7lkgb76fmt5ju5vasqb7amcljqag8h.apps.googleusercontent.com
VITE_FB_APP_ID=955338716906984
